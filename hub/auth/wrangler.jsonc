{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "historica-hub-auth",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	// better-auth keeps each request's context in AsyncLocalStorage.
	"compatibility_flags": ["nodejs_compat"],
	// Reachable only through the hub worker's `AUTH` service binding: no
	// workers.dev address, no preview URLs, no route.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// The hub's own address, which every auth URL and cookie is under.
		// `wrangler dev` reads http://localhost:8787 from .dev.vars instead.
		"BETTER_AUTH_URL": "https://historica-hub.harrisadam42103.workers.dev",
		// The address the hub's mail comes from, which EMAIL below allows.
		"EMAIL_FROM": "noreply@signin.diaryx.org"
	},
	"send_email": [
		{
			// Cloudflare Email Sending: verification and password-reset links,
			// to any address. Needs signin.diaryx.org enabled for sending, with
			// Email preview off, so Cloudflare does not keep the messages (each
			// one a live link). `wrangler dev` writes each message to a file
			// and logs where, rather than sending it.
			"name": "EMAIL",
			"allowed_sender_addresses": ["noreply@signin.diaryx.org"]
		}
	],
	"d1_databases": [
		{
			// The accounts, their handles, sessions and push keys; and the
			// hub's repositories, members and holdings, which the hub's worker
			// binds too. migrations/ creates them all.
			"binding": "DB",
			"database_name": "historica-hub-auth",
			"database_id": "e4f16c0c-7f71-4537-a1b2-c76c1a52d04e",
			"migrations_dir": "migrations"
		}
	]
	// Secrets: BETTER_AUTH_SECRET, and GITHUB_CLIENT_ID and
	// GITHUB_CLIENT_SECRET to offer GitHub sign-in. `wrangler secret put` for
	// a deployed hub; `.dev.vars` for `wrangler dev`.
}
