{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "historica-hub",
	"main": "build/index.js",
	"compatibility_date": "2025-09-01",
	"build": {
		// worker-build compiles this crate for wasm32 and generates its
		// bindings; 0.8.7 matches the worker crate it builds.
		"command": "cargo install -q worker-build --version '=0.8.7' && worker-build --release"
	},
	// The browser's half, which `../build.sh` writes into public/client/.
	// Cloudflare serves a request for one of these before the worker is
	// asked.
	"assets": {
		"directory": "./public",
		// The worker reads the static view through this, at
		// /client/view/, to serve it as each repository's /browse/.
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			// Every file pushed, once, under `blobs/sha256/<digest>`; and each
			// repository's manifest and site listing under `repos/<id>/`.
			"binding": "HUB",
			"bucket_name": "historica-hub"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				// One per repository, holding it open in memory.
				"name": "REPOSITORY",
				"class_name": "Repository"
			}
		]
	},
	"d1_databases": [
		{
			// The auth worker's database (../auth/wrangler.jsonc), for the
			// hub's own tables in it: repositories, members, and what each
			// holds. Its migrations are applied from ../auth.
			"binding": "DB",
			"database_name": "historica-hub-auth",
			"database_id": "e4f16c0c-7f71-4537-a1b2-c76c1a52d04e"
		}
	],
	"services": [
		{
			// The auth worker, ../auth/: better-auth, and whose push key a
			// bearer token is.
			"binding": "AUTH",
			"service": "historica-hub-auth"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Repository"]
		}
	]
}
